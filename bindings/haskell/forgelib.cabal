cabal-version: 3.0
name: forgelib
version: 0.0.1
synopsis: Official Haskell package for Forge
description: Metadata release for the future first-party Haskell binding for Forge, the standard library for agent-built SaaS.
homepage: https://github.com/isala404/forge
bug-reports: https://github.com/isala404/forge/issues
license: MIT
author: Isala Piyarisi
maintainer: mail@isala.me
category: Database
build-type: Simple
extra-source-files: README.md

library
  exposed-modules: ForgeLib
  hs-source-dirs: src
  build-depends: base >=4.14 && <5
  default-language: Haskell2010
