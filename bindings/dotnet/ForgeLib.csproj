<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>ForgeLib</PackageId>
    <Version>0.0.1</Version>
    <Authors>Isala Piyarisi</Authors>
    <Description>Metadata release for the future first-party .NET binding for Forge, the standard library for agent-built SaaS.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/isala404/forge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/isala404/forge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
