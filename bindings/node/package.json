{
  "name": "forgelib",
  "version": "1.0.1",
  "description": "Node.js bindings for Forge: hardened infra primitives on Postgres",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isala404/forge.git",
    "directory": "bindings/node"
  },
  "homepage": "https://isala404.github.io/forge/",
  "bugs": "https://github.com/isala404/forge/issues",
  "keywords": [
    "postgres",
    "queue",
    "kv",
    "backend",
    "napi-rs"
  ],
  "main": "client.js",
  "types": "client.d.ts",
  "files": [
    "README.md",
    "client.js",
    "client.d.ts",
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "exports": {
    ".": {
      "types": "./client.d.ts",
      "default": "./client.js"
    }
  },
  "napi": {
    "binaryName": "forgelib",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
