{
  "name": "forgelib",
  "version": "0.0.1",
  "description": "Node.js bindings for Forge: hardened infra primitives on Postgres",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isala404/forge.git",
    "directory": "bindings/node"
  },
  "main": "client.js",
  "types": "client.d.ts",
  "files": [
    "README.md",
    "client.js",
    "client.d.ts",
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "exports": {
    ".": {
      "types": "./client.d.ts",
      "default": "./client.js"
    }
  },
  "napi": {
    "name": "forgelib",
    "triples": {
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "engines": {
    "node": ">=18"
  }
}
