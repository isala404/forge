# Server
HOST=0.0.0.0
PORT=9081

# Logging (error, warn, info, debug, trace)
RUST_LOG=info,forge_runtime::function::executor=trace

# Postgres container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=forge
POSTGRES_DB=todo
POSTGRES_PORT=5432

# JWT signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=dev-jwt-secret-not-for-production-use-please-rotate

# Enable offline mode for sqlx compile-time checks
SQLX_OFFLINE=true
