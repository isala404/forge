# OrbStack overrides. OrbStack does not forward the published 127.0.0.1:8081-8083
# backend ports to the host, but reaches every container at <name>.orb.local. The
# SPA bakes its backend URL into env.js at container start, so point each FE at the
# backend's orb.local hostname and the host browser (Playwright) can reach it. The
# FE ports 8091-8093 forward normally.
#
#   docker compose --env-file .env.orb up -d --build
#
# On plain Docker Desktop these aren't needed; the compose defaults target 127.0.0.1.
RS_GRAPHQL_HTTP=http://chatapp-rs-app-1.orb.local:8081/graphql
RS_GRAPHQL_WS=ws://chatapp-rs-app-1.orb.local:8081/graphql

NODE_GRAPHQL_HTTP=http://chatapp-node-app-1.orb.local:8082/graphql
NODE_GRAPHQL_WS=ws://chatapp-node-app-1.orb.local:8082/graphql

PYBE_GRAPHQL_HTTP=http://chatapp-pybe-backend-1.orb.local:8083/graphql
PYBE_GRAPHQL_WS=ws://chatapp-pybe-backend-1.orb.local:8083/graphql
