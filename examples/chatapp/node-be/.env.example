# Backend configuration. The defaults target the shared dev Postgres.
FORGE_POSTGRES_URL=postgres://postgres:forge@127.0.0.1:5432/chatapp_node
FORGE_BLOB_SIGNING_SECRET=dev-secret-change-me
PORT=8082
HOST=127.0.0.1
CORS_ORIGIN=*
# Required only to enable the private structured diagnostics endpoint.
OPS_TOKEN=replace-with-a-long-random-operator-token
APP_PRESENCE_TTL_SECS=30
APP_SCHEDULER_MS=30000
APP_DISAPPEARING_SECS=86400
