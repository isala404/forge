# Server
HOST=0.0.0.0
PORT=9081

# Logging (error, warn, info, debug, trace)
# Default: info for forge crates, warn for dependencies
# Use debug/trace for troubleshooting specific modules
RUST_LOG=warn,forge=info

# Postgres container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=forge
POSTGRES_DB=todo-dioxus
POSTGRES_PORT=5432

# JWT signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
