{
  "uid": "forge-sre",
  "title": "Forge SRE",
  "description": "SRE dashboard: service health, jobs, workflows, reactor, crons, security, infrastructure, errors, logs, and traces.",
  "editable": true,
  "schemaVersion": 39,
  "tags": ["forge", "sre"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "fiscalYearStartMonth": 0,
  "templating": {
    "list": [
      {
        "name": "bot_filter",
        "type": "custom",
        "label": "Bot Filter",
        "current": { "text": "exclude bots", "value": "AND is_bot = false" },
        "options": [
          { "text": "all", "value": "", "selected": false },
          { "text": "exclude bots", "value": "AND is_bot = false", "selected": true },
          { "text": "bots only", "value": "AND is_bot = true", "selected": false }
        ],
        "query": "all : ,exclude bots : AND is_bot = false,bots only : AND is_bot = true"
      },
      {
        "name": "tenant",
        "type": "textbox",
        "label": "Tenant ID",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "interval",
        "type": "interval",
        "label": "Interval",
        "current": { "text": "5m", "value": "5m" },
        "options": [
          { "text": "1m", "value": "1m", "selected": false },
          { "text": "5m", "value": "5m", "selected": true },
          { "text": "15m", "value": "15m", "selected": false },
          { "text": "1h", "value": "1h", "selected": false },
          { "text": "6h", "value": "6h", "selected": false },
          { "text": "1d", "value": "1d", "selected": false }
        ],
        "query": "1m,5m,15m,1h,6h,1d"
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "row", "title": "Service Health", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": []
    },
    {
      "id": 2, "type": "stat", "title": "Request Rate (rpm)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) / GREATEST(EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) / 60, 1) AS rpm FROM forge_signals_events WHERE event_type = 'rpc_call' AND $__timeFilter(timestamp) ${bot_filter}",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 3, "type": "stat", "title": "Error Rate (%)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 10 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE status = 'error') / GREATEST(COUNT(*), 1), 1) AS error_pct FROM forge_signals_events WHERE event_type = 'rpc_call' AND $__timeFilter(timestamp) ${bot_filter}",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 4, "type": "stat", "title": "p95 Latency (ms)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY duration_ms) AS p95 FROM forge_signals_events WHERE event_type = 'rpc_call' AND duration_ms IS NOT NULL AND $__timeFilter(timestamp) ${bot_filter}",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 5, "type": "stat", "title": "Active SSE Sessions",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) FROM forge_sessions WHERE status = 'connected'",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 6, "type": "stat", "title": "Cluster Nodes",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) FROM forge_nodes WHERE status IN ('active', 'starting') AND last_heartbeat > NOW() - INTERVAL '30 seconds'",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 7, "type": "stat", "title": "Frontend Errors",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) FROM forge_signals_events WHERE event_type = 'error' AND $__timeFilter(timestamp) ${bot_filter}",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },

    {
      "id": 8, "type": "row", "title": "Jobs", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "panels": []
    },
    {
      "id": 9, "type": "stat", "title": "Queue Depth",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) FROM forge_jobs WHERE status IN ('pending', 'claimed', 'running')",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 10, "type": "stat", "title": "Failures (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) FROM forge_jobs WHERE status = 'failed' AND failed_at > NOW() - INTERVAL '1 hour'",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 11, "type": "barchart", "title": "p95 Duration by Job Type",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [{
        "rawSql": "SELECT job_type, PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (completed_at - started_at)) * 1000) AS p95_ms FROM forge_jobs WHERE status = 'completed' AND started_at IS NOT NULL AND completed_at IS NOT NULL AND $__timeFilter(started_at) GROUP BY job_type ORDER BY p95_ms DESC LIMIT 10",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 12, "type": "stat", "title": "Dead Letter Count",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) FROM forge_jobs WHERE status = 'dead_letter'",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },

    {
      "id": 13, "type": "row", "title": "Workflows", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "panels": []
    },
    {
      "id": 14, "type": "barchart", "title": "Runs by Status",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "options": { "stacking": { "mode": "normal" } },
      "targets": [{
        "rawSql": "SELECT status, COUNT(*) AS count FROM forge_workflow_runs WHERE $__timeFilter(started_at) GROUP BY status ORDER BY count DESC",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 15, "type": "stat", "title": "Blocked Runs",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 15 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) FROM forge_workflow_runs WHERE status IN ('blocked_missing_version', 'blocked_signature_mismatch', 'blocked_missing_handler')",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 16, "type": "barchart", "title": "Step p95 Duration",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 15 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [{
        "rawSql": "SELECT step_name, PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (completed_at - started_at)) * 1000) AS p95_ms FROM forge_workflow_steps WHERE status = 'completed' AND started_at IS NOT NULL AND completed_at IS NOT NULL AND $__timeFilter(started_at) GROUP BY step_name ORDER BY p95_ms DESC LIMIT 10",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 17, "type": "timeseries", "title": "Signature Mismatches (trend)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 15 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [{
        "rawSql": "SELECT $__timeGroup(started_at, $interval) AS time, COUNT(*) FILTER (WHERE status = 'blocked_signature_mismatch') AS mismatches FROM forge_workflow_runs WHERE $__timeFilter(started_at) GROUP BY 1 ORDER BY 1",
        "format": "time_series",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },

    {
      "id": 18, "type": "row", "title": "Reactor", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "panels": []
    },
    {
      "id": 19, "type": "stat", "title": "Changes/sec",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) / GREATEST(EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)), 1) AS changes_per_sec FROM forge_change_log WHERE $__timeFilter(created_at)",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 21, "type": "barchart", "title": "Changes by Table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [{
        "rawSql": "SELECT table_name, COUNT(*) AS count FROM forge_change_log WHERE $__timeFilter(created_at) GROUP BY table_name ORDER BY count DESC LIMIT 10",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },

    {
      "id": 22, "type": "row", "title": "Crons", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "panels": []
    },
    {
      "id": 23, "type": "table", "title": "Last Run per Cron",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [{
        "rawSql": "SELECT DISTINCT ON (cron_name) cron_name, status, scheduled_time, started_at, completed_at, error FROM forge_cron_runs ORDER BY cron_name, scheduled_time DESC",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 24, "type": "stat", "title": "Missed Executions",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 33 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) FROM forge_cron_runs WHERE status = 'pending' AND scheduled_time < NOW() - INTERVAL '5 minutes'",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 25, "type": "stat", "title": "Cron Failures (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 33 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*) FROM forge_cron_runs WHERE status = 'failed' AND completed_at > NOW() - INTERVAL '1 hour'",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },

    {
      "id": 26, "type": "row", "title": "Security", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "panels": []
    },
    {
      "id": 27, "type": "timeseries", "title": "Auth Failures/min",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [{
        "rawSql": "SELECT $__timeGroup(timestamp, $interval) AS time, COUNT(*) AS failures FROM forge_signals_events WHERE event_name = 'auth.failed' AND $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1",
        "format": "time_series",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 28, "type": "timeseries", "title": "Rate Limit Hits/min",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [{
        "rawSql": "SELECT $__timeGroup(timestamp, $interval) AS time, COUNT(*) AS hits FROM forge_signals_events WHERE event_name = 'rate_limit.exceeded' AND $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1",
        "format": "time_series",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },

    {
      "id": 29, "type": "row", "title": "Infrastructure", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 }, "panels": []
    },
    {
      "id": 30, "type": "timeseries", "title": "DB Connections (active/idle/max)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "db_client_connection_count",
          "legendFormat": "active",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A"
        },
        {
          "expr": "db_client_connection_idle_count",
          "legendFormat": "idle",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "B"
        },
        {
          "expr": "db_client_connection_max",
          "legendFormat": "max",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "C"
        }
      ]
    },
    {
      "id": 31, "type": "table", "title": "Node Heartbeat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 47 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [{
        "rawSql": "SELECT hostname, ip_address, status, roles, current_connections, current_jobs, ROUND(cpu_usage::numeric, 1) AS cpu, ROUND(memory_usage::numeric, 1) AS memory, last_heartbeat, started_at FROM forge_nodes ORDER BY last_heartbeat DESC",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },

    {
      "id": 32, "type": "row", "title": "Errors", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 55 }, "panels": []
    },
    {
      "id": 33, "type": "timeseries", "title": "Error Trend",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 56 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [{
        "rawSql": "SELECT $__timeGroup(timestamp, $interval) AS time, COUNT(*) AS errors FROM forge_signals_events WHERE (event_type = 'error' OR status = 'error') AND $__timeFilter(timestamp) ${bot_filter} GROUP BY 1 ORDER BY 1",
        "format": "time_series",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },
    {
      "id": 34, "type": "table", "title": "Top Errors",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 56 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
      "targets": [{
        "rawSql": "SELECT error_message, COUNT(*) AS count, COUNT(DISTINCT session_id) AS sessions, MAX(timestamp) AS last_seen FROM forge_signals_events WHERE error_message IS NOT NULL AND $__timeFilter(timestamp) ${bot_filter} GROUP BY error_message ORDER BY count DESC LIMIT 20",
        "format": "table",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "forge_pg" },
        "refId": "A"
      }]
    },

    {
      "id": 35, "type": "row", "title": "Logs", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 62 }, "panels": []
    },
    {
      "id": 36, "type": "logs", "title": "Application Logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 63 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "{service_name=~\".+\"}",
        "datasource": { "type": "loki", "uid": "loki" },
        "refId": "A"
      }]
    },

    {
      "id": 37, "type": "row", "title": "Traces", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 71 }, "panels": []
    },
    {
      "id": 38, "type": "table", "title": "Recent Traces",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 72 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{
        "queryType": "nativeSearch",
        "limit": 20,
        "datasource": { "type": "tempo", "uid": "tempo" },
        "refId": "A"
      }]
    }
  ]
}