import { getForgeClient, createSubscriptionStore } from "@forge-rs/svelte";
import type {
  User,
  UserSummary,
} from "./types";

// Queries
export const getUser = (args: { id: string }): Promise<UserSummary | null> =>
  getForgeClient().call("get_user", args);
export const listUsers = (): Promise<User[]> =>
  getForgeClient().call("list_users", null);

// Subscriptions
export const getUserStore$ = (args: { id: string }) =>
  createSubscriptionStore<{ id: string }, UserSummary | null>("get_user", args);
export const listUsersStore$ = () =>
  createSubscriptionStore<null, User[]>("list_users", null);

