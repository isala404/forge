// @generated by FORGE - DO NOT EDIT

import { getForgeClient, createSubscriptionStore, createJobStore, createWorkflowStore } from "@forge-rs/svelte";
import type {
  CleanupOutput,
  CleanupRequest,
  CreateTodoInput,
  ReportInput,
  ReportOutput,
  Todo,
  TodoStatus,
} from "./types";

// Queries
export const countByStatus = (args: { status: TodoStatus }): Promise<number> =>
  getForgeClient().call("count_by_status", args);
export const listMyTodos = (): Promise<Todo[]> =>
  getForgeClient().call("list_my_todos", null);

// Subscriptions
export const countByStatusStore$ = (args: { status: TodoStatus }) =>
  createSubscriptionStore<{ status: TodoStatus }, number>("count_by_status", args);
export const listMyTodosStore$ = () =>
  createSubscriptionStore<null, Todo[]>("list_my_todos", null);

// Mutations
export const createTodo = (args: CreateTodoInput): Promise<Todo> =>
  getForgeClient().call("create_todo", args);
export const deleteTodo = (args: { id: string }): Promise<boolean> =>
  getForgeClient().call("delete_todo", args);

// Jobs
export const trackCleanupOldTodos = (args: { request: CleanupRequest }) =>
  createJobStore<{ request: CleanupRequest }, CleanupOutput>("cleanup_old_todos", args);

// Workflows
export const trackBuildReport = (args: ReportInput) =>
  createWorkflowStore<ReportInput, ReportOutput>("build_report", args);

