import { getForgeClient, createSubscriptionStore } from "@forge-rs/svelte";
import type {
  CreateTodoInput,
  Todo,
  UpdateTodoInput,
} from "./types";

// Queries
export const listTodos = (): Promise<Todo[]> =>
  getForgeClient().call("list_todos", null);

// Subscriptions
