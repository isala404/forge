{
  "primitive": "ratelimit",
  "scenarios": [
    {
      "name": "check_decrements_then_denies",
      "note": "The full IETF decision (allowed/limit/remaining/reset_after/retry_after) must come back in every language.",
      "steps": [
        { "op": "ratelimit.check", "args": { "bucket": "b", "key": "u", "max": 2, "per_seconds": 60 },
          "expect": { "shape": { "allowed": true, "limit": 2, "remaining": { "$type": "number" }, "reset_after_seconds": { "$type": "number" }, "retry_after_seconds": null } } },
        { "op": "ratelimit.check", "args": { "bucket": "b", "key": "u", "max": 2, "per_seconds": 60 },
          "expect": { "shape": { "allowed": true } } },
        { "op": "ratelimit.check", "args": { "bucket": "b", "key": "u", "max": 2, "per_seconds": 60 },
          "expect": { "shape": { "allowed": false, "retry_after_seconds": { "$type": "number" } } } }
      ]
    },
    {
      "name": "namespace_isolation",
      "note": "ratelimit counters are namespaced today (one of kv/ratelimit/blob); the same bucket+key under two namespaces must not share a counter.",
      "steps": [
        { "op": "ratelimit.check", "args": { "bucket": "b", "key": "u", "max": 1, "per_seconds": 60 }, "namespace": "app-a", "expect": { "shape": { "allowed": true } } },
        { "op": "ratelimit.check", "args": { "bucket": "b", "key": "u", "max": 1, "per_seconds": 60 }, "namespace": "app-a", "expect": { "shape": { "allowed": false } } },
        { "op": "ratelimit.check", "args": { "bucket": "b", "key": "u", "max": 1, "per_seconds": 60 }, "namespace": "app-b", "expect": { "shape": { "allowed": true } } }
      ]
    },
    {
      "name": "sliding_window_algo_selectable",
      "note": "The algo param ('token_bucket' default | 'sliding_window') must be selectable in every language and still admit then deny within one window.",
      "steps": [
        { "op": "ratelimit.check", "args": { "bucket": "sw", "key": "u", "max": 2, "per_seconds": 60, "algo": "sliding_window" },
          "expect": { "shape": { "allowed": true, "limit": 2, "remaining": { "$type": "number" } } } },
        { "op": "ratelimit.check", "args": { "bucket": "sw", "key": "u", "max": 2, "per_seconds": 60, "algo": "sliding_window" },
          "expect": { "shape": { "allowed": true } } },
        { "op": "ratelimit.check", "args": { "bucket": "sw", "key": "u", "max": 2, "per_seconds": 60, "algo": "sliding_window" },
          "expect": { "shape": { "allowed": false, "retry_after_seconds": { "$type": "number" } } } },
        { "op": "ratelimit.check", "args": { "bucket": "sw", "key": "u", "max": 2, "per_seconds": 60, "algo": "bogus" },
          "expect": { "error": "Invalid" } }
      ]
    }
  ]
}
